# Copie para .env e preencha
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Opcional: habilita login com Google (OAuth client web, origem http://localhost:5173)
GOOGLE_CLIENT_ID=
BACKEND_PORT=3333
# Origens do frontend liberadas no CORS (vírgula separa; * vale para previews do Vercel)
