# ---- docker compose local: copie para .env ----
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
BACKEND_PORT=3333
# Opcional: login com Google (OAuth client web; origem http://localhost:5173)
GOOGLE_CLIENT_ID=

# ---- Produção ----
# Backend (Render/Railway):
#   MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net
#   DB_NAME=estante
#   JWT_SECRET=<openssl rand -hex 32>
#   FRONTEND_ORIGIN=https://seu-site.vercel.app,https://seu-site-*.vercel.app
#   GOOGLE_CLIENT_ID=<opcional>
# Frontend (Vercel, lidas no build):
#   BACKEND_URL=https://sua-api.onrender.com
#   GOOGLE_CLIENT_ID=<opcional, mesmo do backend>
